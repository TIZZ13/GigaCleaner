<ui:FluentWindow x:Class="GigaCleaner.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:ctrl="clr-namespace:GigaCleaner.Controls"
                 xmlns:views="clr-namespace:GigaCleaner.Views"
                 Title="GigaCleaner"
                 Width="1080" Height="720"
                 MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Background="Transparent"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 FontFamily="{StaticResource AppFont}"
                 FontSize="13"
                 Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                 Height="36"
                 Padding="8,0,8,0"
                 FontSize="14">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ctrl:LogoGlyph Width="32" Height="32"
                                    VerticalAlignment="Center" Margin="12,0,10,0" />
                    <TextBlock Text="GigaCleaner" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource GlassFillBrush}"
                BorderBrush="{DynamicResource GlassEdgeInnerBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,18">
                    <Button x:Name="ThemeButton" Style="{StaticResource SidebarAction}" Click="OnThemeToggle"
                            HorizontalAlignment="Stretch" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="ThemeIcon" Symbol="WeatherMoon24" FontSize="15"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="ThemeLabel" Text="Тёмная тема" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource RowSeparator}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding RightsText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                    <Button x:Name="HotkeyButton" Content="Хоткей: Shift + C"
                            Style="{StaticResource GlassChip}"
                            Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            Click="OnHotkeySettings"
                            ToolTip="Настроить глобальную клавишу быстрой очистки" />
                    <Button Content="О программе"
                            Style="{StaticResource GlassChip}"
                            Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            Click="OnAbout"
                            ToolTip="Версия, сайт и обновления" />
                </StackPanel>

                <Grid Margin="12,8,12,0" VerticalAlignment="Top">
                    <!-- Скользящий индикатор активного пункта меню -->
                    <Border x:Name="NavIndicator" CornerRadius="9"
                            Background="{DynamicResource GlassFillBrush}"
                            BorderBrush="{DynamicResource GlassEdgeInnerBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Height="34"
                            Margin="0"
                            IsHitTestVisible="False" />
                    <StackPanel x:Name="NavPanel" VerticalAlignment="Top">
                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}"
                                 IsChecked="{Binding Selected, Converter={StaticResource PageMatch}, ConverterParameter=Overview, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:NavIcon Symbol="ShieldCheckmark24" SymbolForeground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Обзор" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Margin="0,2,0,0"
                                 IsChecked="{Binding Selected, Converter={StaticResource PageMatch}, ConverterParameter=Clean, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:NavIcon Symbol="Broom24" SymbolForeground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Очистка" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Margin="0,2,0,0"
                                 IsChecked="{Binding Selected, Converter={StaticResource PageMatch}, ConverterParameter=Optimize, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:NavIcon Symbol="Gauge24" SymbolForeground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Оптимизация" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Margin="0,2,0,0"
                                 IsChecked="{Binding Selected, Converter={StaticResource PageMatch}, ConverterParameter=Registry, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:NavIcon Symbol="DocumentTable24" SymbolForeground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Реестр" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Margin="0,2,0,0"
                                 IsChecked="{Binding Selected, Converter={StaticResource PageMatch}, ConverterParameter=Updates, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:NavIcon Symbol="ArrowSync24" SymbolForeground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Обновления" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Margin="0,2,0,0"
                                 IsChecked="{Binding Selected, Converter={StaticResource PageMatch}, ConverterParameter=Tools, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:NavIcon Symbol="WrenchScrewdriver24" SymbolForeground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="Инструменты" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
<RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Margin="0,2,0,0"
                                 IsChecked="{Binding Selected, Converter={StaticResource PageMatch}, ConverterParameter=Automation, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <ctrl:NavIcon Symbol="CalendarClock24" SymbolForeground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Автоматизация" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

            <Border x:Name="PagesHost" Grid.Column="2" Background="{DynamicResource AppBackgroundBrush}">
                <Grid>
                    <views:OverviewPage Visibility="{Binding DataContext.Selected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=Overview}" />
                    <views:CleanPage Visibility="{Binding DataContext.Selected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=Clean}" />
                    <views:OptimizePage Visibility="{Binding DataContext.Selected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=Optimize}" />
                    <views:RegistryPage Visibility="{Binding DataContext.Selected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=Registry}" />
                    <views:UpdatesPage Visibility="{Binding DataContext.Selected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=Updates}" />
                    <views:ToolsPage Visibility="{Binding DataContext.Selected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=Tools}" />
                    <views:AutomationPage Visibility="{Binding DataContext.Selected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=Automation}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
