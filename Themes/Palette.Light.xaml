<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E9E9EC" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#F1F1F3" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#EFEFF1" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E4E4E7" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18181B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#71717A" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />

    <!-- Liquid Glass: светлая тема (нейтральное стекло, чуть плотнее чистого белого) -->
    <SolidColorBrush x:Key="GlassFillBrush" Color="#F0F0F0F2" />
    <LinearGradientBrush x:Key="GlassFillGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F8F8F8FA" Offset="0" />
        <GradientStop Color="#E8E8E8EC" Offset="0.55" />
        <GradientStop Color="#CFD4D6DC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassEdgeOuterBrush" Color="#55202830" />
    <SolidColorBrush x:Key="GlassEdgeOuterHoverBrush" Color="#88334050" />
    <LinearGradientBrush x:Key="GlassEdgeInnerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6ECEDF2" Offset="0" />
        <GradientStop Color="#86A8ADB8" Offset="0.5" />
        <GradientStop Color="#324A4E5C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassTopHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCD3D5D9" Offset="0" />
        <GradientStop Color="#00D3D5D9" Offset="1" />
    </LinearGradientBrush>
    <!-- Тени: одна мягкая, почти симметричная (не «провисает» снизу) -->
    <DropShadowEffect x:Key="GlassShadow" BlurRadius="16" ShadowDepth="2" Direction="270"
                      Color="#66000000" Opacity="0.16" />
    <DropShadowEffect x:Key="GlassShadowHover" BlurRadius="18" ShadowDepth="3" Direction="270"
                      Color="#88000000" Opacity="0.2" />

    <!-- Светлая тема: глубина стекла (нейтральная, чуть плотнее белого) -->
    <Color x:Key="GlassDepthTop">#8CFFFFFF</Color>
    <Color x:Key="GlassDepthMid">#66F5F5F7</Color>
    <Color x:Key="GlassDepthBottom">#38D8D8DC</Color>

    <!-- Поле ввода: заметная стеклянная подложка -->
    <LinearGradientBrush x:Key="GlassFieldFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4F4F4F6" Offset="0" />
        <GradientStop Color="#E4E4E4E8" Offset="0.55" />
        <GradientStop Color="#C8CDD0D6" Offset="1" />
    </LinearGradientBrush>

    <!-- Тень кнопок: мягкая, равномерная -->
    <DropShadowEffect x:Key="ControlShadow" BlurRadius="10" ShadowDepth="1.5" Direction="270"
                      Color="#40000000" Opacity="0.18" />
    <DropShadowEffect x:Key="ControlShadowHover" BlurRadius="12" ShadowDepth="2" Direction="270"
                      Color="#60000000" Opacity="0.24" />

</ResourceDictionary>
