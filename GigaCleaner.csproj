<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GigaCleaner</RootNamespace>
    <AssemblyName>GigaCleaner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);Notifier\**</DefaultItemExcludes>

    <!-- Метаданные сборки: видны в «Свойствах файла» и помогают SmartScreen -->
    <Company>GigaCleaner</Company>
    <Product>GigaCleaner</Product>
    <AssemblyTitle>GigaCleaner</AssemblyTitle>
    <Description>Очистка и оптимизация Windows: временные файлы, реестр, автозагрузка, обновления.</Description>
    <Copyright>Copyright © 2026 GigaCleaner</Copyright>
    <Version>1.1.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo-g.png" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.34" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Notifier\bin\Release\publish\GigaCleaner.Notifier.exe"
                      LogicalName="GigaCleaner.Notifier.exe"
                      Condition="Exists('Notifier\bin\Release\publish\GigaCleaner.Notifier.exe')" />
  </ItemGroup>

  <Target Name="PublishNotifierIfMissing" BeforeTargets="CoreCompile"
          Condition="!Exists('Notifier\bin\Release\publish\GigaCleaner.Notifier.exe')">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\Notifier\GigaCleaner.Notifier.csproj&quot; -c Release -p:PublishProfile=SelfContainedSingleFile -o &quot;$(MSBuildProjectDirectory)\Notifier\bin\Release\publish&quot; --nologo" />
  </Target>

</Project>
