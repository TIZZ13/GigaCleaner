<UserControl x:Class="GigaCleaner.Views.OptimizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GigaCleaner.Views">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Left">
            <TextBlock Text="Оптимизация" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="Службы Windows, программы, сон и безопасная автозагрузка."
                       Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,18,0,0"
                    Style="{StaticResource CompactTabControl}"
                    ItemContainerStyle="{StaticResource CompactTabItem}">
            <TabItem Header="Windows">
                <views:WindowsRecommendationsTab />
            </TabItem>
            <TabItem Header="Программы">
                <views:SmartAnalysisTab />
            </TabItem>
            <TabItem Header="Спящий режим">
                <views:SleepTab />
            </TabItem>
            <TabItem Header="Автозагрузка">
                <views:AutostartTab />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
