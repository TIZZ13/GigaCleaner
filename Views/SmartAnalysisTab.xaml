<UserControl x:Class="GigaCleaner.Views.SmartAnalysisTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:GigaCleaner.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Неиспользуемые программы" Style="{StaticResource Text.Section}" />
                <TextBlock Text="Не открывались дольше 60 дней. Показаны размер программы и возможность убрать автозапуск."
                           Style="{StaticResource Text.Caption}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Анализ" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ScanCommand}" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12,0,12">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer ctrl:ScrollBehavior.EnableSmooth="True" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Recommendations}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctrl:GlassCard Margin="0,0,0,10" Padding="16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                               Margin="10,1,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}"
                                           Margin="0,4,0,0" Foreground="{DynamicResource AccentBrush}"
                                           Visibility="{Binding Status, Converter={StaticResource EmptyToCollapsed}}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Отключить автозапуск" Style="{StaticResource SmallSecondaryButton}"
                                            Command="{Binding DisableAutostartCommand}"
                                            Visibility="{Binding CanDisableAutostart, Converter={StaticResource BoolToVisibility}}"
                                            Margin="0,0,8,6" />
                                    <Button Content="Усыпить" Style="{StaticResource SmallSecondaryButton}"
                                            ToolTip="Снизит приоритет CPU и ввода-вывода, не замораживая процесс."
                                            Command="{Binding SleepCommand}"
                                            Visibility="{Binding CanSleep, Converter={StaticResource BoolToVisibility}}"
                                            Margin="0,0,8,6" />
                                    <Button Content="Удалить" Style="{StaticResource SmallSecondaryButton}"
                                            ToolTip="Откроет штатный деинсталлятор программы."
                                            Command="{Binding UninstallCommand}"
                                            Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVisibility}}"
                                            Margin="0,0,8,6" />
                                </WrapPanel>
                            </StackPanel>
                        </ctrl:GlassCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
