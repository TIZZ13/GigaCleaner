<UserControl x:Class="GigaCleaner.Views.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:GigaCleaner.Controls">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Обновления" Style="{StaticResource Text.PageTitle}" />
<TextBlock Text="Драйверы устанавливаются через Центр обновления Windows."
                       Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Проверить обновления" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ScanCommand}" VerticalAlignment="Center" />
        </Grid>

        <ctrl:GlassCard Grid.Row="1" Margin="0,20,0,16" Padding="18,14">
            <StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,5,0,0"
                           Text="Обновления не устанавливаются автоматически. Драйверы устанавливаются в Центре обновления Windows." />
            </StackPanel>
        </ctrl:GlassCard>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DriverStatus}" Style="{StaticResource Text.Body}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Открыть Центр обновления"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding OpenWindowsUpdateCommand}" />
            </Grid>

            <StackPanel Grid.Row="1" Style="{StaticResource EmptyState}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource EmptyStateIcon}">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="26" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
                <TextBlock Text="Обновлений драйверов нет" Style="{StaticResource Text.Body}"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Text="Система обновлена. Проверить ещё раз можно кнопкой выше."
                           Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <ScrollViewer ctrl:ScrollBehavior.EnableSmooth="True" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Drivers}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Style="{StaticResource Text.Caption}"
                                               Margin="0,5,0,0" Foreground="{DynamicResource AccentBrush}">
                                        <Run Text="{Binding SizeText}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding StateText}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
