<UserControl x:Class="GigaCleaner.Views.SleepTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctrl="clr-namespace:GigaCleaner.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Фоновые приложения" Style="{StaticResource Text.Section}" />
                <TextBlock Text="Снижение приоритета или усыпление всех процессов приложения с мгновенным пробуждением."
                           Style="{StaticResource Text.Caption}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Обновить" Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12,0,12">
            <TextBlock Text="{Binding Notice}" Style="{StaticResource Text.Caption}"
                       Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,4"
                       Visibility="{Binding Notice, Converter={StaticResource EmptyToCollapsed}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                       Text="Системные процессы, антивирусы и GigaCleaner защищены. Пониженный приоритет сохраняется между запусками. Замороженные приложения автоматически проснутся при закрытии GigaCleaner; после сбоя — при следующем запуске." />
        </StackPanel>

        <ScrollViewer ctrl:ScrollBehavior.EnableSmooth="True" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel Style="{StaticResource EmptyState}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource EmptyStateIcon}">
                        <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="26" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="Нет приложений под управлением" Style="{StaticResource Text.Body}"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="Запущенные программы появятся здесь после сканирования."
                               Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Groups}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctrl:GlassCard Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Caption}"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="Снизить приоритет" Style="{StaticResource SmallSecondaryButton}"
                                            Command="{Binding LowerCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding CanLower, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="Усыпить" Style="{StaticResource SmallSecondaryButton}"
                                            Command="{Binding SuspendCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding CanSuspend, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="Разбудить" Style="{StaticResource SmallPrimaryButton}"
                                            Command="{Binding WakeCommand}"
                                            Visibility="{Binding CanWake, Converter={StaticResource BoolToVisibility}}" />
                                </WrapPanel>
                            </Grid>
                        </ctrl:GlassCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
