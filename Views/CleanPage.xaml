<UserControl x:Class="GigaCleaner.Views.CleanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:GigaCleaner.Controls">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="Очистка" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                <ProgressBar Width="240" Height="4" Margin="0,8,0,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Сканировать" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ScanCommand}" VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Command="{Binding CleanCommand}" Margin="8,0,0,0" VerticalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Content" Value="Очистить" />
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding JustCleaned}" Value="True">
                                <Setter Property="Content" Value="✓ Очищено!" />
                                <Setter Property="Background" Value="#16A34A" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding JustCleaned}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#16A34A" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <ctrl:GlassCard Grid.Row="1" Margin="0,20,0,16" Padding="18,14" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalText}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Bottom" Margin="12,0,0,3" />
                </StackPanel>
                <Button Grid.Column="1" Content="Cookies и вход" Style="{StaticResource SecondaryButton}"
                        Click="OnCookieWhitelist" VerticalAlignment="Center" />
            </Grid>
        </ctrl:GlassCard>

        <ScrollViewer ctrl:ScrollBehavior.EnableSmooth="True" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,22">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" Margin="0" />
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                           Visibility="{Binding Hint, Converter={StaticResource EmptyToCollapsed}}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ctrl:GlassCard Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Margin="16,12,0,12">
                                                    <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="10,11">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" />
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding FreedText}" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding HasFreed}" Value="True" />
                                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ctrl:GlassCard}}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeText, Mode=OneWay}"
                                                           Style="{StaticResource Text.Caption}" FontSize="13"
                                                           VerticalAlignment="Center" Margin="0,0,16,0" />
                                            </Grid>
                                        </ctrl:GlassCard>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
