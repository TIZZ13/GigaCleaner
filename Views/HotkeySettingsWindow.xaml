<Window x:Class="GigaCleaner.Views.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:GigaCleaner.Controls"
        Title="Горячая клавиша"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <StackPanel Margin="26,22,26,22">
        <TextBlock Text="Быстрая очистка" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Нажмите желаемую комбинацию клавиш — она станет глобальной для «Очистить в 1 клик»." />

        <!-- Стеклянное поле захвата, как наши кнопки -->
        <ctrl:GlassCard x:Name="CaptureCard" Margin="0,18,0,0" Padding="0" HorizontalAlignment="Stretch">
            <Button x:Name="CaptureButton" Background="Transparent" BorderThickness="0"
                    Padding="0" Height="46" HorizontalAlignment="Stretch"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontSize="15" FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="OnCaptureClick">
                <Grid>
                    <TextBlock x:Name="CaptureLabel" Text="Shift + C"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel x:Name="WaitingPanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Opacity="0">
                        <Ellipse x:Name="Dot1" Width="6" Height="6" Opacity="0.25"
                                 Fill="{DynamicResource TextPrimaryBrush}" />
                        <Ellipse x:Name="Dot2" Width="6" Height="6" Opacity="0.25" Margin="5,0,0,0"
                                 Fill="{DynamicResource TextPrimaryBrush}" />
                        <Ellipse x:Name="Dot3" Width="6" Height="6" Opacity="0.25" Margin="5,0,0,0"
                                 Fill="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </ctrl:GlassCard>

        <TextBlock x:Name="HintText" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                   Text="Нажмите на поле, затем зажмите новую комбинацию." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Сбросить (Shift+C)" Style="{StaticResource SmallSecondaryButton}"
                    Effect="{x:Null}" Click="OnReset" />
            <Button Content="Готово" Style="{StaticResource PrimaryButton}"
                    Effect="{x:Null}" Click="OnOk" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>