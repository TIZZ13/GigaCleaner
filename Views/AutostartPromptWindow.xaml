<Window x:Class="GigaCleaner.Views.AutostartPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GigaCleaner"
        Width="460" Height="Auto"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <StackPanel Margin="28,26,28,24">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Добавить GigaCleaner в автозагрузку?"
                       FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="Приложение будет запускаться вместе с Windows — уборка и оптимизация всегда под рукой, а уведомления будут приходить без лишних действий. Можно отключить в любой момент в разделе «Оптимизация»." />

        <TextBlock Text="Рекомендуется включить." Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                   FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Не добавлять" Style="{StaticResource SecondaryButton}" Click="OnDecline" />
            <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Click="OnAccept" Margin="10,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>