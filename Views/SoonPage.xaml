<UserControl x:Class="GigaCleaner.Views.SoonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="32" VerticalAlignment="Top" HorizontalAlignment="Stretch" MaxWidth="720">
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
            <TextBlock Style="{StaticResource Text.Body}"
                       Text="Раздел подключается следующим модулем. Навигация, темы и рабочий движок очистки уже собраны." />
        </Border>
    </StackPanel>
</UserControl>
