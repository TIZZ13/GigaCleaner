<UserControl x:Class="GigaCleaner.Views.WindowsRecommendationsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:GigaCleaner.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Рекомендации по Windows" Style="{StaticResource Text.Section}" />
                <TextBlock Text="Встроенные службы и компоненты, которые включены, но не используются."
                           Style="{StaticResource Text.Caption}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Сканировать" Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12,0,12">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                       Text="Отключаются только перечисленные безопасные службы. Сеть, звук, Защитник Windows и Центр обновлений защищены от изменений. Исходное состояние сохраняется в settings.json." />
        </StackPanel>

        <ScrollViewer ctrl:ScrollBehavior.EnableSmooth="True" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctrl:GlassCard Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <Border Background="{DynamicResource NavSelectedBrush}" CornerRadius="4"
                                                Padding="6,2" Margin="10,1,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Caption}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SavingsText}" Style="{StaticResource Text.Caption}"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding ActionText}"
                                        Command="{Binding ToggleCommand}"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        VerticalAlignment="Center" Margin="16,0,0,0"
                                        Visibility="{Binding CanAct, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </ctrl:GlassCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
